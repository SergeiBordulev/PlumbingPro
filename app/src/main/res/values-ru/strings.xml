    <string name="calc_pipe_volume">Объем трубы и вместимость воды</string>
    <string name="calc_pipe_volume_desc">Расчет внутреннего объема трубы, объема воды и веса заправленной воды.</string>

    <string name="calc_flow_rate">Расход воды и скорость потока</string>
