    <string name="code_ipc_title">IPC - Código Internacional de Fontanería (EE.UU.)</string>
    <string name="code_ipc_desc">Mantenido por ICC (International Code Council). Código modelo adoptado en la mayoría de los estados de EE.UU.</string>
    <string name="code_ipc_btn">Abrir guía oficial IPC</string>

    <string name="code_upc_title">UPC - Código Uniforme de Fontanería (EE.UU.)</string>
    <string name="code_upc_desc">Mantenido por IAPMO. Ampliamente utilizado en estados y jurisdicciones del oeste de EE.UU.</string>
    <string name="code_upc_btn">Abrir guía oficial UPC</string>

    <string name="code_npc_title">NPC - Código Nacional de Fontanería de Canadá</string>
    <string name="code_npc_desc">Publicado por el Conseil national de recherches Canada (NRC). Modelo de código utilizado en las provincias canadienses.</string>
    <string name="code_npc_btn">Abrir guía oficial NPC Canadá</string>

    <string name="code_csa_title">Normas de Fontanería CSA (Canadá)</string>
    <string name="code_csa_desc">Estándares de la Asociación Canadiense de Normalización para accesorios y tuberías de fontanería.</string>
    <string name="code_csa_btn">Abrir guía oficial CSA Group</string>

    <string name="quick_ref_title">Guía rápida y tablas normativas</string>
    <string name="ref_dwv_slopes">Pendientes de tubería de drenaje (IPC / UPC):</string>
    <string name="ref_dwv_slopes_detail">• 2" o menor: 1/4" por pie (pendiente 2%)\n• 3" a 6": 1/8" por pie (pendiente 1%)\n• 8" o mayor: 1/16" por pie (pendiente 0.5%)</string>

    <string name="ref_water_velocity">Límites de velocidad del agua:</string>
    <string name="ref_water_velocity_detail">• Tuberías de agua fría: Máx. 8 ft/s (2.4 m/s)\n• Tuberías de agua caliente (&gt;60°C): Máx. 5 ft/s (1.5 m/s) para evitar erosión-corrosión.</string>

    <string name="ref_pipe_roughness">Coeficiente de rugosidad C (Hazen-Williams):</string>
    <string name="ref_pipe_roughness_detail">• PEX / CPVC / PVC: C = 150\n• Tubería de cobre: C = 140\n• Acero inoxidable: C = 150\n• Acero galvanizado: C = 120\n• Hierro fundido: C = 100</string>

