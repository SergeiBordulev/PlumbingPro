    <string name="codes_title">Códigos y Normas de Fontanería</string>
    <string name="codes_subtitle">Manuales oficiales y guía rápida de consulta</string>
    <string name="us_codes_title">🇺🇸 Códigos de Fontanería de EE.UU.</string>
