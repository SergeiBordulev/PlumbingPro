    <!-- Calculators Titles -->
    <string name="calc_pipe_volume">Volumen y capacidad de tubería</string>
    <string name="calc_pipe_volume_desc">Calcula el volumen interno, volumen de agua y peso total del agua en una tubería.</string>

    <string name="calc_flow_rate">Caudal y velocidad del flujo</string>
    <string name="calc_flow_rate_desc">Calcula la velocidad del agua y el caudal volumétrico en tuberías.</string>

    <string name="calc_pipe_sizing">Selección de diámetro de tubería</string>
    <string name="calc_pipe_sizing_desc">Calcula el diámetro interno mínimo de tubería y el tamaño recomendado según el caudal.</string>

    <string name="calc_pipe_slope">Pendiente y caída de tubería</string>
    <string name="calc_pipe_slope_desc">Calcula la caída (desnivel) o el porcentaje de pendiente requerido para drenaje.</string>

    <string name="calc_pressure_drop">Caída de presión en tuberías</string>
    <string name="calc_pressure_drop_desc">Estima las pérdidas por fricción y caída de presión mediante la fórmula Hazen-Williams.</string>

    <string name="calc_thermal_expansion">Expansión térmica de tuberías</string>
    <string name="calc_thermal_expansion_desc">Calcula la dilatación térmica lineal de los materiales debido a cambios de temperatura.</string>

    <string name="calc_tank_volume">Capacidad del tanque y calentador</string>
    <string name="calc_tank_volume_desc">Calcula la capacidad de agua para tanques de almacenamiento cilíndricos y rectangulares.</string>

    <string name="calc_fixture_units">Unidades de fijación (DFU y WSFU)</string>
    <string name="calc_fixture_units_desc">Calcula el total de Unidades de Fijación de Drenaje y Suministro de Agua y el diámetro de tubería recomendado.</string>

